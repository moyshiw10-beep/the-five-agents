# העתיקו לקובץ .env ומלאו ערכים אמיתיים

# --- מסד נתונים ---
DATABASE_URL="postgresql://user:password@localhost:5432/hall_management"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-long-string"

# --- חיבור ללוגליג (Logliga) ---
# LOGLIGA_USE_MOCK=true מדמה משחקים לצורך פיתוח/בדיקות בלי חיבור אמיתי
LOGLIGA_USE_MOCK=true
LOGLIGA_BASE_URL="https://loglig.com"
LOGLIGA_USERNAME=""
LOGLIGA_PASSWORD=""

# --- שליחת מיילים (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ניהול אולמות <no-reply@example.com>"

# --- סוד להפעלת endpoints מתוזמנים (cron) מבחוץ ---
CRON_SECRET="replace-with-a-random-secret"
