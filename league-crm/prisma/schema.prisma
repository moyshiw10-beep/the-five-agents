// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// NOTE: status fields are plain String (validated with Zod at the app boundary,
// see app/lib/definitions.ts) instead of native Prisma enums. This keeps the
// schema portable between SQLite (local dev, see prisma.config.ts) and
// PostgreSQL (production/Supabase) without any type changes when switching
// providers - only the `provider` line below needs to change.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id               String    @id @default(cuid())
  name             String
  phone            String
  notes            String?
  status           String    @default("NEW")
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  status    String   @default("ACTIVE")
  players   Player[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  status    String   @default("ACTIVE")
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
